// 01 - Hello, world
//
// Comments start with // and run to the end of the line.
// Every statement ends with a semicolon, and print always ends the line.

print "Hello, world!";

// print works on every kind of value
print 42;
print 3.14;
print true;
print null;

// Strings are joined with +
string language = "tl";
print "Welcome to " + language + "!";

// A string has no escape sequences: it runs up to the next double quote,
// and it may span several lines.
print "this string
covers two lines";

// Expressions can be printed directly
print 6 * 7;
print "answer: " + "forty-two";
